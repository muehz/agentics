{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" codex pre-tool",
                        "commandWindows": "cmd /c \"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" codex pre-tool",
                        "timeout": 25
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" codex startup",
                        "commandWindows": "cmd /c \"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" codex startup",
                        "timeout": 25
                    }
                ]
            }
        ]
    }
}
