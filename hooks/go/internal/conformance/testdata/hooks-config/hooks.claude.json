{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "^(?:Read|Grep|Glob|NotebookRead|Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|mcp__.*)$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" claude-code pre-tool",
                        "timeout": 25
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" claude-code startup",
                        "timeout": 25
                    }
                ]
            }
        ]
    }
}
