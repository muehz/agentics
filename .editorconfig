# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Prettier is the only tool that reads this file today. It applies the indent
# widths below to the markdown, JSON, YAML, and JavaScript it formats, and
# skips every other type. The Go and Makefile sections therefore enforce
# nothing here — gofmt and make itself do that — and are kept as the written
# record of tab-vs-space intent for whoever writes the next file. A section
# that matches no file in the repository is deleted, not kept as decoration.

# Defaults for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown files
# Preserve double-space line breaks in markdown
[*.md]
trim_trailing_whitespace = false

# YAML files (GitHub Actions workflows, etc.)
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 4

# JavaScript and TypeScript files
[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 4

# Go files — gofmt emits tabs and is not configurable
[*.go]
indent_style = tab
indent_size = 4

# Makefiles — recipe lines MUST begin with a literal tab or make hard-errors
# ("missing separator"). Never relax this to spaces.
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4
