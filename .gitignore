vite.config.js.timestamp-*
vite.config.ts.timestamp-*

.DS_Store

# Git worktrees
.worktrees/

# Node
node_modules/

# husky runtime shims, generated by `npm install` (prepare script)
.github/husky/_/

# Copy-on-build artifact paths (no current tracked producer)
docs/contributing/architecture.md

# Generated catalog path (no current tracked producer)
site/src/data/catalog.json

# Copied glossary path (no current tracked producer)
docs/reference/glossary.md

# Local plugin development overrides (personal, not shared)
.claude/settings.local.json
.github/copilot/settings.local.json

# Local planning and audit artifacts
.claude/plans/
.audit/

# Git worktrees
.claude/worktrees/

# Explore workspace artifact paths (no current tracked producer)
explore/node_modules
explore/dist
explore/.vite-cache
explore/coverage

# Agentics SPA artifact path (no current tracked producer)
site/static/explore/

# Agentics package artifact path (no current tracked producer)
dist-pkg/

# Antigravity/agy CLI session state
.antigravitycli/

# Local working directories — ignored by Git but included when present in
# directory-mode plugin installs (the working tree is copied as-is)
extensions/
.agentics/

# `go build ./cmd/hook/` run from hooks/ drops the binary there, not bin/
/hooks/hook
/hooks/hook.exe
/hooks/bin/
/bin/agx.exe


# peer review reports are unstaged workspace artifacts (.github/tools/README.md)
/docs/reviews/peer/

# handoff and resume capsules are local session artifacts (skills/handoff/SKILL.md).
# CI evidence belongs in a workflow artifact, not the tree.
/docs/handoffs/

# Probe evidence is a local working artifact; it is not tracked.
/docs/probes/

# A work folder's temp/ holds scratch and evidence; it is not tracked
# (skills/decompose/references/chain-artifacts.md).
/docs/specs/**/temp/

# The small-fix log is never committed, in any storage setting.
/docs/specs/unassigned/

# Raw eval captures stay local; CI uploads them as expiring workflow artifacts.
/evals/runs/

# Go coverage profiles and Cobertura reports (CONTRIBUTING.md's documented
# local reproduction, and the Go coverage report in .github/workflows/validate.yml)
/coverage-hooks.out
/cobertura-hooks.xml
/cobertura.xml
hooks/go/coverage.out
# Mutation testing (Stryker sandbox and reports)
.stryker-tmp/
reports/mutation/
reports/mutation-incremental/
