{
    "name": "agentics-tools",
    "private": true,
    "type": "module",
    "description": "Maintainer-only dev tools. Not part of the shipped plugin.",
    "dependencies": {
        "yaml": "2.9.1"
    },
    "engines": {
        "node": "^22.23.5 || ^24.22.3 || >=26.12.1"
    },
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "node src/scripts/node-test.ts \"src/**/*.test.ts\"",
        "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\" && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"**/testing/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"src/**/*.test.ts\""
    }
}
